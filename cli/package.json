{
  "name": "context-shifter",
  "version": "0.1.1",
  "type": "module",
  "description": "Turn any AI conversation into a portable context card. Local-first via Ollama. CLI companion to the Context Transfer macOS app.",
  "license": "MIT",
  "bin": {
    "context-shifter": "dist/bin.js",
    "cshift": "dist/bin.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm",
    "context",
    "context-card",
    "ollama",
    "anthropic",
    "nvidia",
    "nim",
    "prompt",
    "conversation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shivala-08/context-shifter.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/Shivala-08/context-shifter/issues"
  },
  "homepage": "https://github.com/Shivala-08/context-shifter#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync-prompt": "node scripts/sync-prompt.mjs",
    "check-prompt": "node scripts/sync-prompt.mjs --check",
    "test": "node scripts/sync-prompt.mjs && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "prepack": "node scripts/sync-prompt.mjs && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
